---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="Jeremy Hoover | Product, Design, and AI Systems">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__id">
        <img class="hero__avatar" src={`${base}/images/jeremy-hoover.jpg`} alt="Jeremy Hoover" width="144" height="144" />
        <div>
          <p class="hero__role">Senior Content Designer at Microsoft and UXCC instructor</p>
        </div>
      </div>
      <div class="hero__main">
      <h1 class="hero__name">I design AI systems and developer tools.</h1>
      <p class="hero__pitch">Content, AI workflows, and product experiences that connect design, product, and engineering.</p>
      <div class="hero__actions">
        <a href="#projects" class="btn btn--on-dark">Explore selected projects<Icon name="arrow-down" /></a>
        <a href="#contact" class="btn btn--on-dark btn--outline">Get in touch</a>
      </div>
      </div>
    </div>
  </section>

  <!-- SELECTED PROJECTS -->
  <section class="projects">
    <div class="wrap">
      <div class="section-header" id="projects">
        <h2>Selected projects</h2>
      </div>
      <div class="projects__grid">

        <a href={`${base}/work/ai-design-repo`} class="project project--blue">
          <div class="project__body">
            <div class="project__head">
              <span class="project__icon"><img src={`${base}/images/case-studies/ai-design-repo.webp`} alt="Git branch graph where concept, prototype, and handoff branches merge back into one shared main branch after checks pass" width="48" height="48" loading="lazy" /></span>
              <h3>I build the repos our teams use to design with AI</h3>
            </div>
            <ul class="project__points">
              <li><strong>Hundreds</strong> of designers, PMs, and engineers use the repos I've built</li>
              <li><strong>Required</strong> for how our designers prototype</li>
              <li><strong>Used</strong> for ideation, demos, customer concepts, and handoff</li>
            </ul>
            <ul class="project__tools" aria-label="Tools used">
              <li><img src="https://cdn.simpleicons.org/githubcopilot" alt="" width="14" height="14" loading="lazy" />GitHub Copilot</li>
              <li><img src="https://cdn.simpleicons.org/github" alt="" width="14" height="14" loading="lazy" />GitHub</li>
              <li><Icon name="code" size={14} />VS Code</li>
            </ul>
            <div class="project__foot"><span class="project__link">Read case study<Icon name="arrow-outward" /></span></div>
          </div>
        </a>

        <a href={`${base}/work/hackathon`} class="project project--violet">
          <div class="project__body">
            <div class="project__head">
              <span class="project__icon"><img src={`${base}/images/case-studies/hackathon-agent.webp`} alt="A product requirements document with highlighted requirements turned into a confirmed report and assigned work items, with a Best Use of AI award ribbon" width="48" height="48" loading="lazy" /></span>
              <h3>I turned a requirements maze into an agent that starts from your PRD</h3>
            </div>
            <ul class="project__points">
              <li><strong>Winner,</strong> Best Use of AI, as a three-person team</li>
              <li><strong>3 days</strong> from idea to working proof of concept</li>
              <li><strong>Shared</strong> across the PM org and fed into its skills and agents</li>
            </ul>
            <ul class="project__tools" aria-label="Tools used">
              <li><Icon name="code" size={14} />VS Code</li>
              <li><img src="https://cdn.simpleicons.org/github" alt="" width="14" height="14" loading="lazy" />GitHub</li>
              <li><img src="https://cdn.simpleicons.org/githubcopilot" alt="" width="14" height="14" loading="lazy" />GitHub Copilot</li>
              <li class="tools-more" aria-label="Also: MCPs, Azure DevOps">+2
                <ul class="tools-pop" role="tooltip">
                  <li><img src="https://cdn.simpleicons.org/modelcontextprotocol" alt="" width="14" height="14" loading="lazy" />MCPs</li>
                  <li><Icon name="board" size={14} class="tool-ado" />Azure DevOps</li>
                </ul>
              </li>
            </ul>
            <div class="project__foot"><span class="project__link">Read case study<Icon name="arrow-outward" /></span></div>
          </div>
        </a>

        <a href={`${base}/work/org-ai-initiatives`} class="project project--orange">
          <div class="project__body">
            <div class="project__head">
              <span class="project__icon"><img src={`${base}/images/case-studies/org-ai-initiatives.webp`} alt="A field of dots representing designers, adopting outward from a central hub through three rings: agent, knowledge base, and training" width="48" height="48" loading="lazy" /></span>
              <h3>How I got my design org actually using AI</h3>
            </div>
            <ul class="project__points">
              <li><strong>Hundreds</strong> of designers use the content-design agent I created</li>
              <li><strong>3 efforts</strong> I took from idea to required workflow</li>
              <li><strong>I run</strong> the review process for the org's shared knowledge base</li>
            </ul>
            <ul class="project__tools" aria-label="Tools used">
              <li><Icon name="code" size={14} />VS Code</li>
              <li><img src="https://cdn.simpleicons.org/github" alt="" width="14" height="14" loading="lazy" />GitHub</li>
              <li><img src="https://cdn.simpleicons.org/githubcopilot" alt="" width="14" height="14" loading="lazy" />GitHub Copilot</li>
              <li class="tools-more" aria-label="Also: MCPs, Azure DevOps">+2
                <ul class="tools-pop" role="tooltip">
                  <li><img src="https://cdn.simpleicons.org/modelcontextprotocol" alt="" width="14" height="14" loading="lazy" />MCPs</li>
                  <li><Icon name="board" size={14} class="tool-ado" />Azure DevOps</li>
                </ul>
              </li>
            </ul>
            <div class="project__foot"><span class="project__link">Read case study<Icon name="arrow-outward" /></span></div>
          </div>
        </a>

        <a href={`${base}/work/fabric-cli`} class="project project--green">
          <div class="project__body">
            <div class="project__head">
              <span class="project__icon"><img src={`${base}/images/case-studies/fabric-cli.webp`} alt="Fabric CLI terminal session where an agent loads context, mode, prompt, and skill, then completes a verified task" width="48" height="48" loading="lazy" /></span>
              <h3>I built the AI skills that shipped with Fabric CLI</h3>
            </div>
            <ul class="project__points">
              <li><strong>Shipped at GA</strong> with Fabric CLI in March 2026</li>
              <li><strong>36 files</strong> in my main AI assets pull request</li>
              <li><strong>Public</strong> PRs, release notes, and a launch article I co-wrote</li>
            </ul>
            <ul class="project__tools" aria-label="Tools used">
              <li><img src="https://cdn.simpleicons.org/githubcopilot" alt="" width="14" height="14" loading="lazy" />GitHub Copilot</li>
              <li><img src="https://cdn.simpleicons.org/claude" alt="" width="14" height="14" loading="lazy" />Claude</li>
              <li><img src="https://cdn.simpleicons.org/cursor" alt="" width="14" height="14" loading="lazy" />Cursor</li>
              <li class="tools-more" aria-label="Also: GitHub">+1
                <ul class="tools-pop" role="tooltip">
                  <li><img src="https://cdn.simpleicons.org/github" alt="" width="14" height="14" loading="lazy" />GitHub</li>
                </ul>
              </li>
            </ul>
            <div class="project__foot"><span class="project__link">Read case study<Icon name="arrow-outward" /></span></div>
          </div>
        </a>

        <a href={`${base}/work/statecraft-israel`} class="project project--game">
          <div class="project__body">
            <div class="project__head">
              <span class="project__icon"><img src={`${base}/images/case-studies/statecraft-israel.jpg`} alt="Statecraft: Israel gameplay showing the 1948 map and the Tel Aviv city-management panel" width="48" height="48" loading="lazy" /></span>
              <h3>Research, writing rules, and UI copy for a history game</h3>
            </div>
            <ul class="project__points">
              <li><strong>20 PRs</strong> merged into a public strategy game</li>
              <li><strong>8 studies</strong> of historical research and source checks</li>
              <li><strong>4 skills</strong> for research, writing, UX copy, and video scripts</li>
            </ul>
            <ul class="project__tools" aria-label="Tools used">
              <li><img src="https://cdn.simpleicons.org/github" alt="" width="14" height="14" loading="lazy" />GitHub</li>
              <li><img src="https://cdn.simpleicons.org/unity/000000" alt="" width="14" height="14" loading="lazy" />Unity</li>
            </ul>
            <div class="project__foot"><span class="project__link">Read case study<Icon name="arrow-outward" /></span></div>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- RECENT EXPERIENCE -->
  <section class="experience">
    <div class="wrap">
      <div class="section-header" id="experience">
        <h2>Recent experience</h2>
        <a href={`${base}/about`} class="section-header__link">Full background &#8594;</a>
      </div>
      <div class="exp__layout">
      <div class="exp__list">

        <article class="exp__item">
          <span class="exp__logo" aria-hidden="true"><span class="microsoft-mark"><i></i><i></i><i></i><i></i></span></span>
          <div class="exp__body">
            <div class="exp__meta"><p class="exp__company">Microsoft</p><p class="exp__period">2022 &ndash; present</p></div>
            <p class="exp__title">Senior Content Designer, AI systems and developer experiences</p>
            <p class="exp__desc">Designing content and product experiences for Microsoft Fabric CI/CD, CLI, and MCP tools. Building AI workflows and evaluation frameworks, owning the team design automation repo, and contributing across org-wide AI initiatives.</p>
          </div>
        </article>
        <article class="exp__item">
          <span class="exp__logo" aria-hidden="true"><img src="https://uxcontent.com/wp-content/uploads/2024/03/cropped-UXCC-THUMB-circle-192x192.png" alt="" width="36" height="36" loading="lazy" /></span>
          <div class="exp__body">
            <div class="exp__meta"><p class="exp__company">UX Content Collective</p><p class="exp__period">2026 &ndash; present</p></div>
            <p class="exp__title">Creator and instructor, Technical Content Designer Program</p>
            <p class="exp__desc">Created and lead a program that gives content designers hands-on experience with developer tools and AI systems.</p>
          </div>
        </article>
        <article class="exp__item">
          <span class="exp__logo" aria-hidden="true"><img src="https://cdn.jsdelivr.net/npm/simple-icons@13.21.0/icons/wix.svg" alt="" width="32" height="32" loading="lazy" /></span>
          <div class="exp__body">
            <div class="exp__meta"><p class="exp__company">Wix.com</p><p class="exp__period">2018 &ndash; 2022</p></div>
            <p class="exp__title">Senior UX Writer · Accessibility Champion</p>
            <p class="exp__desc">Lead UX writer for Wix Code. Content strategy, usability testing, A/B testing, localization across 15+ languages. Accessibility champion across the org. Hackathon winner.</p>
          </div>
        </article>

      </div>
      <aside class="cred-card" id="education" aria-labelledby="cred-title">
        <h3 id="cred-title">Education and recognition</h3>
        <dl>
          <div><dt>BA, History, Minor in Journalism</dt><dd>Metropolitan State University of Denver</dd></div>
          <div><dt>Hackathon winner, Best Use of AI</dt><dd>Microsoft</dd></div>
          <div><dt>Hackathon winner, Accessibility</dt><dd>Wix.com</dd></div>
        </dl>
      </aside>
      </div>
    </div>
  </section>

  <!-- PROFESSIONAL RECOMMENDATIONS -->
  <section class="recommendations" aria-labelledby="recommendations-title">
    <div class="wrap">
      <div class="section-header recommendations__header" id="recommendations">
        <div>
          <h2 id="recommendations-title">What colleagues say</h2>
        </div>
      </div>
      <div class="recommendations__grid">
        <figure class="recommendation-card recommendation-card--blue">
          <blockquote>
            <p>Jeremy Hoover is a leader in using AI tools and LLM systems to optimize content design and drive measurable business outcomes. His deep understanding of engineering systems, backend workflows, GitHub, and VS Code ensures AI is operationalized in practice, not theory.</p>
            <p>Jeremy is actively shaping how teams build, scale, and responsibly integrate AI into everyday product development and content strategy. And on top of his technical experience, he&rsquo;s an outstanding collaborator and mentor.</p>
          </blockquote>
          <figcaption>
            <img src={`${base}/images/testimonials/colleague-elena-v2.png`} alt="" width="96" height="96" loading="lazy" />
            <span>
              <strong>Elena Greenspan</strong>
              <small>UX Writer and Content Designer &middot; Microsoft</small>
            </span>
          </figcaption>
        </figure>

        <figure class="recommendation-card recommendation-card--coral">
          <blockquote>
            <p>Working with Jeremy at Microsoft, I&rsquo;ve benefited tremendously from his expertise at the intersection of AI and content systems. Through his guidance, I was able to build my own AI content agent, which now supports my team&rsquo;s needs, including terminology usage, voice and tone guidelines, and formatting standards.</p>
            <p>Jeremy explained high-level technical concepts in a way that was easy to grasp and empowered me to build my own tools. I highly recommend Jeremy both as a content designer and an expert AI instructor.</p>
          </blockquote>
          <figcaption>
            <img src={`${base}/images/testimonials/colleague-sarabeth-v2.png`} alt="" width="96" height="96" loading="lazy" />
            <span>
              <strong>Sarabeth Reingold</strong>
              <small>UX Writer, UX Designer, and Technical Writer &middot; Microsoft</small>
            </span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- TECHNICAL CONTENT DESIGNER PROGRAM -->
  <section class="program">
    <div class="wrap">
      <div class="section-header" id="program">
        <h2>Technical Content Designer Program</h2>
        <a href="https://uxcontent.com/technical-content-designer-program/" target="_blank" rel="noopener" class="section-header__link">Explore the program &#8599;</a>
      </div>
      <div class="program__grid">
        <div class="program__about">
          <div class="program__org">
            <img src="https://uxcontent.com/wp-content/uploads/2024/03/cropped-UXCC-THUMB-circle-192x192.png" alt="" width="44" height="44" loading="lazy" />
            <p>Creator and instructor<br /><span>UX Content Collective</span></p>
          </div>
          <p class="program__summary">I built and teach this program to give content designers, product designers, and design managers hands-on fluency with the tools engineers use, so they can contribute directly to product work and apply AI responsibly.</p>
          <ul class="program__topics" aria-label="What participants learn">
            <li><Icon name="github" size={14} />Git and GitHub</li>
            <li><Icon name="code" size={14} />VS Code and the terminal</li>
            <li>Working with engineers</li>
            <li>AI in production</li>
          </ul>
        </div>
        <div class="program__quotes" aria-label="Participant feedback">
          <figure class="pq">
            <div class="pq__stars" aria-label="5 out of 5 stars"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            <blockquote><p>This program helped me pave a clearer path to maintaining the strategic helm of language at my company.</p></blockquote>
            <figcaption><img src={`${base}/images/testimonials/participant-feminine.png`} alt="" width="40" height="40" loading="lazy" /><span><strong>Michelle Gerling</strong><small>Content Designer, Gett</small></span></figcaption>
          </figure>
          <figure class="pq">
            <div class="pq__stars" aria-label="5 out of 5 stars"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span></div>
            <blockquote><p>Getting to play with a functioning Git repo helped me understand how to build one. Jeremy is enthusiastic and can speak at length about each topic.</p></blockquote>
            <figcaption><img src={`${base}/images/testimonials/participant-masculine.png`} alt="" width="40" height="40" loading="lazy" /><span><strong>Gabriel Lek</strong><small>Lead UX Writer, Grab</small></span></figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <!-- FIEVEL -->
  <section class="hcs">
    <div class="wrap">
      <div class="hcs__panel" id="open-source">
        <div class="hcs__content">
          <h2>Fievel</h2>
          <p>Your AI content systems architect. Fievel is a repository-native guide that works inside Claude Code, Codex, and GitHub Copilot to help content designers turn product context, writing standards, sources, AI behavior, quality checks, and governance into a connected content system they own and keep improving.</p>
          <p>It ships as a plugin with six skills, a seven-stage workflow, a local CLI that validates and checks the system, and a read-only viewer that maps how every source, rule, and check connects.</p>
          <div class="hcs__links">
            <a href="https://fievel.ai/" target="_blank" rel="noopener" class="btn">Visit fievel.ai<Icon name="arrow-outward" /></a>
            <a href="https://github.com/jeremydhoover-blip/fievel-content-system" target="_blank" rel="noopener" class="btn btn--outline"><Icon name="github" />View on GitHub</a>
          </div>
        </div>
        <div class="hcs__visual" aria-hidden="true">
          <div class="fievel-map">
            <p class="fievel-map__title"><img src="https://fievel.ai/assets/fievel-logo.png" alt="" width="22" height="22" />Fievel system architecture</p>
            <svg viewBox="0 0 760 430" role="presentation">
              <defs>
                <linearGradient id="fv-node" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#ffffff"/><stop offset="100%" stop-color="#eef3fb"/></linearGradient>
                <linearGradient id="fv-node-active" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#e99b78"/><stop offset="100%" stop-color="#c86a50"/></linearGradient>
                <marker id="fv-arrow" viewBox="0 0 12 12" refX="10.5" refY="6" markerWidth="12" markerHeight="12" markerUnits="userSpaceOnUse" orient="auto-start-reverse"><path d="M3 1.5L10.5 6L3 10.5" fill="none" stroke="#aaa3a0" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></marker>
              </defs>
              <g fill="none" stroke="#92939e" stroke-width="1.4" marker-end="url(#fv-arrow)">
                <path d="M120 122V158"/><path d="M380 122V158"/><path d="M220 215H280"/><path d="M480 215H540"/>
                <path d="M380 308V272"/><path d="M640 122V158"/><path d="M540 65H480"/><path d="M480 262L542 314"/>
              </g>
              <g class="fievel-map__edge">
                <text x="130" y="145">shapes</text><text x="390" y="145">grounds</text><text x="250" y="200" text-anchor="middle">guides</text>
                <text x="510" y="195" text-anchor="middle">informs</text><text x="390" y="295">assess</text><text x="650" y="145">maintains</text>
                <text x="510" y="50" text-anchor="middle">approves</text><text x="526" y="280">permits</text>
              </g>
              <g class="fievel-map__node" fill="url(#fv-node)" stroke="#c9d5e6" stroke-width="1.6">
                <rect x="36" y="29" width="168" height="72" rx="26"/><text x="120" y="70">Product context</text>
                <rect x="296" y="29" width="168" height="72" rx="26"/><text x="380" y="70">Sources</text>
                <rect x="556" y="29" width="168" height="72" rx="26"/><text x="640" y="70">Governance</text>
                <rect x="36" y="179" width="168" height="72" rx="26"/><text x="120" y="220">Standards</text>
                <rect x="556" y="179" width="168" height="72" rx="26"/><text x="640" y="220">Skills</text>
                <rect x="296" y="329" width="168" height="72" rx="26"/><text x="380" y="370">Evaluations</text>
                <rect x="556" y="329" width="168" height="72" rx="26"/><text x="640" y="370">Tools</text>
              </g>
              <g class="fievel-map__node fievel-map__node--active" fill="url(#fv-node-active)" stroke="#c4512b" stroke-width="1.6">
                <rect x="296" y="179" width="168" height="72" rx="26"/><text x="380" y="220">AI behavior</text>
              </g>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLISHED ARTICLES -->
  <section class="writing">
    <div class="wrap">
      <div class="section-header" id="writing">
        <h2>Published articles</h2>
      </div>
      <p class="writing__intro">Ideas and practical frameworks across AI systems, technical content design, product measurement, and no-code tools.</p>
      <div class="writing__cols">

        <div class="writing__group">
          <div class="writing__group-head"><p class="writing__src">LinkedIn and Medium</p></div>
          <ul>
            <li><a href="https://medium.com/@jeremyd.hoover/common-ai-generated-design-mistakes-and-easy-solutions-284e5dc30872" target="_blank" rel="noopener"><Icon name="medium" class="writing__icon writing__icon--medium" /><span>Common AI-Generated Design Mistakes and Easy Solutions</span><em>Medium</em></a></li>
            <li><a href="https://www.linkedin.com/pulse/10-new-things-content-designers-can-do-today-ai-jeremy-hoover-p3xvf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>10 New Things Content Designers Can Do Today With AI</span></a></li>
            <li><a href="https://www.linkedin.com/pulse/what-you-need-know-designing-ai-agents-2027-jeremy-hoover-cma6f/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>What You Need to Know About Designing AI Agents in 2027</span></a></li>
          </ul>
          <button type="button" class="writing__more" data-dialog="articles-linkedin">Show all 8 articles</button>
          <dialog id="articles-linkedin" class="articles-dialog" aria-labelledby="articles-linkedin-title">
            <div class="articles-dialog__head">
              <h3 id="articles-linkedin-title">LinkedIn and Medium</h3>
              <button type="button" class="articles-dialog__close" data-close aria-label="Close">&times;</button>
            </div>
            <ul>
              <li><a href="https://medium.com/@jeremyd.hoover/common-ai-generated-design-mistakes-and-easy-solutions-284e5dc30872" target="_blank" rel="noopener"><Icon name="medium" class="writing__icon writing__icon--medium" /><span>Common AI-Generated Design Mistakes and Easy Solutions</span><em>Medium</em></a></li>
              <li><a href="https://www.linkedin.com/pulse/10-new-things-content-designers-can-do-today-ai-jeremy-hoover-p3xvf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>10 New Things Content Designers Can Do Today With AI</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/what-you-need-know-designing-ai-agents-2027-jeremy-hoover-cma6f/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>What You Need to Know About Designing AI Agents in 2027</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/how-my-role-content-design-expanding-systems-jeremy-hoover-arhpe/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>How My Role in Content Design Is Expanding Into Systems</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/my-personal-evolution-creating-agentic-skills-jeremy-hoover-nhckf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>My Personal Evolution: Creating Agentic Skills</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/how-ai-changing-way-i-work-content-designer-jeremy-hoover-qz4gf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>How AI Is Changing the Way I Work</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/missing-link-ai-your-web-knowledge-jeremy-hoover-29kvf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>The Missing Link: AI and Your Web Knowledge</span></a></li>
              <li><a href="https://www.linkedin.com/pulse/beyond-style-guides-build-living-content-system-developer-hoover-efhtf/" target="_blank" rel="noopener"><Icon name="linkedin" class="writing__icon writing__icon--linkedin" /><span>Beyond Style Guides: Build a Living Content System</span></a></li>
            </ul>
          </dialog>
        </div>

        <div class="writing__group">
          <div class="writing__group-head"><p class="writing__src">UX Content Collective</p></div>
          <ul>
