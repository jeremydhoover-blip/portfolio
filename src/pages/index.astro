<script>
  document.querySelectorAll<HTMLButtonElement>('[data-dialog]').forEach((btn) => {
    const dialog = document.getElementById(btn.dataset.dialog ?? '') as HTMLDialogElement | null;
    if (!dialog) return;
    btn.addEventListener('click', () => dialog.showModal());
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  });
</script>
<script>
  // Tool chips: one row, at most 3 visible, the rest behind a "+N" chip with a hover popover.
  const fitTools = () => {
    document.querySelectorAll<HTMLUListElement>('.project__tools').forEach((list) => {
      const all = [...list.querySelectorAll<HTMLLIElement>('li:not(.tools-more)')];
      if (!list.dataset.ready) { list.dataset.ready = '1'; (list as any)._all = all.map((li) => li.cloneNode(true)); }
      const items = (list as any)._all as HTMLLIElement[];
      for (let shown = Math.min(3, items.length); shown >= 1; shown--) {
        list.replaceChildren(...items.slice(0, shown).map((li) => li.cloneNode(true)));
        const rest = items.slice(shown);
        if (rest.length) {
          const more = document.createElement('li');
          more.className = 'tools-more';
          more.setAttribute('aria-label', 'Also: ' + rest.map((li) => li.textContent?.trim()).join(', '));
          more.textContent = '+' + rest.length;
          const pop = document.createElement('ul');
          pop.className = 'tools-pop';
          pop.setAttribute('role', 'tooltip');
          rest.forEach((li) => pop.appendChild(li.cloneNode(true)));
          more.appendChild(pop);
          list.appendChild(more);
          // carry Astro's scoped-style attribute onto the generated elements
          [...list.attributes].filter((a) => a.name.startsWith('data-astro-cid')).forEach((a) => { more.setAttribute(a.name, ''); pop.setAttribute(a.name, ''); });
        }
        const box = list.getBoundingClientRect();
        const padRight = parseFloat(getComputedStyle(list).paddingRight) || 0;
        const last = list.lastElementChild as HTMLElement | null;
        if (!last || last.getBoundingClientRect().right <= box.right - padRight + 1) break;
      }
    });
  };
  fitTools();
  let t: number | undefined;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(fitTools, 120); });
</script>
