---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Jeremy Hoover | Product, Design, and AI Systems">

  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">
        <div class="hero__content">
          <p class="hero__eyebrow">Product strategy · Design systems · AI workflows</p>
          <h1 class="hero__name">Jeremy Hoover</h1>
          <p class="hero__pitch">
            I turn complex product and organizational problems into systems people can use. My career spans journalism, marketing, UX, accessibility, developer tools, and AI products. Today I design customer-facing tools, content experiences, and AI workflows that connect design, product, and engineering.
          </p>
          <p class="hero__context">Microsoft · UX Content Collective instructor · MA HCI at Reichman University</p>
          <div class="hero__actions">
            <a href="#projects" class="btn">Explore selected projects</a>
            <a href="#contact" class="btn btn--outline">Get in touch</a>
          </div>
        </div>
        <div class="hero-system" aria-hidden="true">
          <div class="hero-system__label">How I work</div>
          <div class="hero-system__steps">
            <div class="hero-system__step"><span>01</span><strong>Frame the problem</strong><small>Research + requirements</small></div>
            <div class="hero-system__step hero-system__step--core"><span>02</span><strong>Build the system</strong><small>Product + content design</small></div>
            <div class="hero-system__step"><span>03</span><strong>Ship the tool</strong><small>Customer + team workflows</small></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SELECTED PROJECTS -->
  <section class="projects" id="projects">
    <div class="wrap">
      <div class="section-header">
        <h2>Selected projects</h2>
      </div>
      <div class="projects__grid">

        <a href={`${base}/work/ai-design-repo`} class="project project--blue">
          <div class="project__visual" aria-hidden="true">
            <div class="visual-repo">
              <span class="visual-repo__file">skills/</span>
              <span class="visual-repo__file">agents/</span>
              <span class="visual-repo__file">context/</span>
              <span class="visual-repo__build">Design output</span>
            </div>
          </div>
          <div class="project__body">
            <span class="project__n">01</span>
            <div class="project__tags">
              <span class="tag">AI Systems</span>
              <span class="tag">Product</span>
              <span class="tag">Team workflow</span>
            </div>
            <h3>The repo that changed how our team designs</h3>
            <p>Built an AI-powered design automation system from scratch. Adopted on day one. Now the primary tool 30 designers and PMs use daily for prototyping, handoff, and every senior leadership demo.</p>
            <span class="project__link">Read case study &#8594;</span>
          </div>
        </a>

        <a href={`${base}/work/hackathon`} class="project project--violet">
          <div class="project__visual" aria-hidden="true">
            <div class="visual-agent">
              <span class="visual-agent__input">PRD</span>
              <span class="visual-agent__agent">Agent</span>
              <span class="visual-agent__output">ADO tasks</span>
            </div>
          </div>
          <div class="project__body">
            <span class="project__n">02</span>
            <div class="project__tags">
              <span class="tag">AI Product</span>
              <span class="tag">Best Use of AI</span>
              <span class="tag">Shipped to production</span>
            </div>
            <h3>From hackathon win to org-wide deployment</h3>
            <p>Replaced 50+ scattered PM requirements and a cumbersome ADO workflow with a single agentic experience. Won Best Use of AI. Adopted at the highest org level, reached hundreds of users, and helped start a broader ecosystem of agents.</p>
            <span class="project__link">Read case study &#8594;</span>
          </div>
        </a>

        <a href={`${base}/work/org-ai-initiatives`} class="project project--orange">
          <div class="project__visual" aria-hidden="true">
            <div class="visual-adoption">
              <div class="visual-adoption__point"><small>Initiated</small><strong>Agent</strong></div>
              <span class="visual-adoption__line"></span>
              <div class="visual-adoption__point visual-adoption__point--end"><small>Adopted</small><strong>Across the design org</strong></div>
            </div>
          </div>
          <div class="project__body">
            <span class="project__n">03</span>
            <div class="project__tags">
              <span class="tag">Org-level</span>
              <span class="tag">Design Org</span>
              <span class="tag">Organization-wide adoption</span>
            </div>
            <h3>Building AI infrastructure across the design org</h3>
            <p>An agent I initiated was adopted and used by 150+ designers. I also drove the org knowledge initiative, contributed early to the AI Champs group, and built demos for senior leadership.</p>
            <span class="project__link">Read case study &#8594;</span>
          </div>
        </a>

        <a href={`${base}/work/fabric-cli`} class="project project--green">
          <div class="project__visual" aria-hidden="true">
            <div class="visual-cli">
              <span class="visual-cli__prompt">$ fab agent run</span>
              <span class="visual-cli__line">context loaded</span>
              <span class="visual-cli__line">skill selected</span>
              <span class="visual-cli__done">ready</span>
            </div>
          </div>
          <div class="project__body">
            <span class="project__n">04</span>
            <div class="project__tags">
              <span class="tag">Open Source</span>
              <span class="tag">microsoft/fabric-cli</span>
              <span class="tag">Generally Available</span>
            </div>
            <h3>Shipping AI skills to production in the Fabric CLI</h3>
            <p>Built the AI assets layer of the Fabric CLI that shipped GA in v1.5. Public commits in microsoft/fabric-cli, called out by the Corporate VP of Product. Also shipped internal agent skills for engineers before it was common practice.</p>
            <span class="project__link">Read case study &#8594;</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- RECENT EXPERIENCE -->
  <section class="experience" id="about">
    <div class="wrap">
      <div class="section-header">
        <h2>Recent experience</h2>
        <a href={`${base}/about`} class="section-header__link">Full background &#8594;</a>
      </div>
      <div class="exp__list">

        <div class="exp__item">
          <div class="exp__left">
            <p class="exp__company">Microsoft</p>
            <p class="exp__period">2022 to present</p>
          </div>
          <div class="exp__right">
            <p class="exp__title">Senior Content Designer, AI systems and developer experiences</p>
            <p class="exp__desc">Designing content and product experiences for Microsoft Fabric CI/CD, CLI, and MCP tools. Building AI workflows and evaluation frameworks, owning the team design automation repo, and contributing across org-wide AI initiatives.</p>
          </div>
        </div>

        <div class="exp__item">
          <div class="exp__left">
            <p class="exp__company">UX Content Collective</p>
            <p class="exp__period">2026 to present</p>
          </div>
          <div class="exp__right">
            <p class="exp__title">Creator and instructor, Technical Content Designer Program</p>
            <p class="exp__desc">Created and lead a program that gives content designers hands-on experience with developer tools and AI systems.</p>
          </div>
        </div>

        <div class="exp__item">
          <div class="exp__left">
            <p class="exp__company">Wix.com</p>
            <p class="exp__period">2018 to 2022</p>
          </div>
          <div class="exp__right">
            <p class="exp__title">Senior UX Writer · Accessibility Champion</p>
            <p class="exp__desc">Lead UX writer for Wix Code. Content strategy, usability testing, A/B testing, localization across 15+ languages. Accessibility champion across the org. Hackathon winner.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- EDUCATION + RECOGNITION -->
  <section class="credentials">
    <div class="wrap">
      <div class="section-header credentials__header">
        <h2>Education and recognition</h2>
      </div>
      <div class="cred__grid">

        <div class="cred__block cred__block--education">
          <div class="cred__title"><span aria-hidden="true">01</span><h3>Education</h3></div>
          <ul class="cred__list">
            <li>
              <strong>Reichman University</strong>
              <span>MA, Human-Computer Interaction · 2026 to 2027</span>
              <em>Merit scholarship recipient</em>
            </li>
            <li>
              <strong>Metropolitan State University of Denver</strong>
              <span>BA, History · Minor in Journalism · 2006 to 2011</span>
            </li>
          </ul>
        </div>

        <div class="cred__block cred__block--recognition">
          <div class="cred__title"><span aria-hidden="true">02</span><h3>Recognition</h3></div>
          <ul class="cred__list">
            <li>
              <strong>Best Use of AI</strong>
              <span>Microsoft hackathon winner</span>
            </li>
            <li>
              <strong>Hackathon winner</strong>
              <span>Wix.com</span>
            </li>
            <li>
              <strong>Helen Verba Award</strong>
              <span>Society of Professional Journalists, Metropolitan State University of Denver</span>
            </li>
            <li>
              <strong><a href="https://www.contentdesignleaders.com/upstream" target="_blank" rel="noopener">Content Design Leaders Upstream &#8599;</a></strong>
              <span>Invite-only workgroup shaping what UX content becomes in an AI-driven world</span>
            </li>
            <li>
              <strong>Top of the Rockies Contest, First Place</strong>
              <span>Online law and order feature writing</span>
            </li>
            <li>
              <strong>Top of the Rockies Contest, First Place</strong>
              <span>Health investigative and enterprise reporting</span>
            </li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- HOOVER CONTENT SYSTEM -->
  <section class="hcs">
    <div class="wrap">
      <div class="hcs__panel">
        <div class="hcs__content">
          <p class="hcs__eyebrow">Independent open-source work</p>
          <h2>Hoover Content System</h2>
          <p>A living content system for developer products. I built it to move content guidance out of static documents and into a structured, version-controlled system teams can maintain, extend, and use in their daily work.</p>
          <a href="https://jeremydhoover-blip.github.io/hoover-content-system/" target="_blank" rel="noopener" class="hcs__link">Explore the live system &#8599;</a>
        </div>
        <div class="hcs__visual" aria-hidden="true">
          <div class="hcs-window">
            <div class="hcs-window__bar"><span></span><span></span><span></span></div>
            <div class="hcs-window__body">
              <div class="hcs-window__nav">
                <span>Principles</span><span>Patterns</span><span>Components</span><span>Accessibility</span>
              </div>
              <div class="hcs-window__doc">
                <strong>Content pattern</strong>
                <span></span><span></span><span class="short"></span>
                <div class="hcs-window__code">version: 1.0.0</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PUBLISHED ARTICLES -->
  <section class="writing" id="writing">
    <div class="wrap">
      <div class="section-header">
        <h2>Published articles</h2>
      </div>
      <p class="writing__intro">Ideas and practical frameworks across AI systems, technical content design, product measurement, and no-code tools.</p>
      <div class="writing__cols">

        <div class="writing__group">
          <div class="writing__group-head"><span aria-hidden="true">LI</span><p class="writing__src">LinkedIn</p></div>
          <ul>
            <li><a href="https://www.linkedin.com/pulse/my-personal-evolution-creating-agentic-skills-jeremy-hoover-nhckf/" target="_blank" rel="noopener">My Personal Evolution: Creating Agentic Skills</a></li>
            <li><a href="https://www.linkedin.com/pulse/how-ai-changing-way-i-work-content-designer-jeremy-hoover-qz4gf/" target="_blank" rel="noopener">How AI Is Changing the Way I Work</a></li>
            <li><a href="https://www.linkedin.com/pulse/missing-link-ai-your-web-knowledge-jeremy-hoover-29kvf/" target="_blank" rel="noopener">The Missing Link: AI and Your Web Knowledge</a></li>
            <li><a href="https://www.linkedin.com/pulse/beyond-style-guides-build-living-content-system-developer-hoover-efhtf/" target="_blank" rel="noopener">Beyond Style Guides: Build a Living Content System</a></li>
          </ul>
        </div>

        <div class="writing__group">
          <div class="writing__group-head"><span aria-hidden="true">UX</span><p class="writing__src">UX Content Collective</p></div>
          <ul>
            <li><a href="https://uxcontent.com/essential-ai-concepts-for-content-designers/" target="_blank" rel="noopener">Essential AI Concepts for Content Designers</a></li>
            <li><a href="https://uxcontent.com/technical-content-design/" target="_blank" rel="noopener">Technical Content Design</a></li>
          </ul>
        </div>

        <div class="writing__group">
          <div class="writing__group-head"><span aria-hidden="true">EXT</span><p class="writing__src">External publications</p></div>
          <ul>
            <li><a href="https://www.smashingmagazine.com/2020/07/renaissance-no-code-web-designers/" target="_blank" rel="noopener">The Renaissance of No-Code for Web Designers <em>(contributor, Smashing Magazine)</em></a></li>
            <li><a href="https://uxdesign.cc/kpi-is-the-most-important-tool-ux-designers-should-be-learning-to-use-af31651120fc" target="_blank" rel="noopener">KPI Is the Most Important Tool UX Designers Should Learn</a></li>
          </ul>
        </div>

      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="contact" id="contact">
    <div class="wrap">
      <div class="contact__inner">
        <div>
          <h2>Let's talk</h2>
          <p>Open to conversations about senior PM, product design, and AI engineering roles.</p>
        </div>
        <div class="contact__cta">
          <a href="mailto:jeremyd.hoover@gmail.com" class="btn">jeremyd.hoover@gmail.com</a>
          <a href="https://www.linkedin.com/in/jeremydhoover/" target="_blank" rel="noopener" class="btn btn--outline">LinkedIn</a>
        </div>
      </div>
    </div>
  </section>

</Base>

<style>
  /* ─ HERO ─ */
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background:
      radial-gradient(circle at 82% 18%, rgba(0, 82, 204, 0.12), transparent 25rem),
      linear-gradient(180deg, #ffffff 0%, #f9fbff 100%);
    border-bottom: 1px solid var(--border);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.75fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .hero__eyebrow {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    max-width: none;
  }
  .hero__name {
    margin-bottom: 1.25rem;
    font-size: clamp(3rem, 7vw, 6.4rem);
  }
  .hero__pitch {
    font-size: clamp(1.0625rem, 1.8vw, 1.2rem);
    color: #45433e;
    max-width: 54ch;
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .hero__context {
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 2rem;
    max-width: none;
  }
  .hero__actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .hero-system {
    min-height: 300px;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid rgba(0, 82, 204, 0.14);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 70px rgba(12, 38, 78, 0.12);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero-system__label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .hero-system__steps { display: flex; flex-direction: column; }
  .hero-system__step {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.9rem 0;
    border-top: 1px solid var(--border);
  }
  .hero-system__step span {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: #edf3ff;
    color: var(--accent);
    font-size: 0.625rem;
    font-weight: 700;
  }
  .hero-system__step strong {
    font-family: var(--f-heading);
    font-size: 0.85rem;
    line-height: 1.25;
  }
  .hero-system__step small { color: var(--muted); font-size: 0.68rem; font-weight: 600; text-align: right; }
  .hero-system__step--core {
    margin-inline: -0.75rem;
    padding-inline: 0.75rem;
    border-top-color: transparent;
    border-radius: 12px;
    background: #edf3ff;
    color: var(--text);
  }
  .hero-system__step--core span { background: var(--accent); color: #fff; }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero-system { min-height: 260px; max-width: 680px; }
  }
  @media (max-width: 480px) {
    .hero-system { min-height: auto; border-radius: 16px; }
    .hero-system__step { grid-template-columns: 2rem minmax(0, 1fr); }
    .hero-system__step small { grid-column: 2; text-align: left; }
  }

  /* ─ SECTION HEADER ─ */
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0;
  }
  .section-header__link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted);
  }
  .section-header__link:hover { color: var(--text); }

  /* ─ PROJECTS ─ */
  .projects { padding-block: clamp(3.5rem, 7vw, 6rem); }
  .projects__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--border);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    background: #fff;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .project:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 44px rgba(21, 26, 35, 0.11);
    text-decoration: none;
  }
  .project__visual {
    min-height: 210px;
    display: grid;
    place-items: center;
    padding: 2rem;
    overflow: hidden;
  }
  .project--blue .project__visual { background: linear-gradient(135deg, #dce9ff, #f1f6ff); }
  .project--violet .project__visual { background: linear-gradient(135deg, #eee4ff, #faf7ff); }
  .project--orange .project__visual { background: linear-gradient(135deg, #ffead6, #fff7ef); }
  .project--green .project__visual { background: linear-gradient(135deg, #dff5e9, #f3fbf7); }
  .project__body {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: 1.5rem;
    flex: 1;
  }
  .project__n {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--muted);
    max-width: none;
  }
  .project__tags { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .project__body h3 { font-size: clamp(1.15rem, 2vw, 1.4rem); margin-top: 0.15rem; }
  .project__body p { font-size: 0.9375rem; color: var(--muted); line-height: 1.65; }
  .project__link { margin-top: auto; padding-top: 0.5rem; font-size: 0.875rem; font-weight: 700; color: var(--accent); }
  .visual-repo {
    width: min(100%, 340px);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 0.5rem;
  }
  .visual-repo__file {
    padding: 0.75rem 0.5rem;
    border: 1px solid #9dbbf0;
    border-radius: 7px;
    background: rgba(255,255,255,0.75);
    color: #174b9f;
    font: 600 0.7rem monospace;
    text-align: center;
  }
  .visual-repo__build {
    grid-column: 1 / -1;
    margin-top: 0.7rem;
    padding: 1rem;
    border-radius: 9px;
    background: #0052cc;
    color: #fff;
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
  }
  .visual-agent {
    width: min(100%, 340px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
  }
  .visual-agent span { padding: 1rem 0.65rem; border-radius: 10px; text-align: center; font-size: 0.75rem; font-weight: 700; }
  .visual-agent__input, .visual-agent__output { background: rgba(255,255,255,0.75); border: 1px solid #c8aae9; color: #60318f; }
  .visual-agent__agent { background: #7339aa; color: #fff; box-shadow: 0 8px 20px rgba(115,57,170,0.22); }
  .visual-adoption {
    width: min(100%, 390px);
    display: grid;
    grid-template-columns: 1fr minmax(42px, 0.35fr) 1.4fr;
    align-items: center;
    gap: 0;
  }
  .visual-adoption__point {
    padding: 1rem 1.1rem;
    border: 1px solid #d88a42;
    border-radius: 999px;
    background: #fff;
    color: #713707;
    text-align: center;
  }
  .visual-adoption__point--end { background: #9d4c00; color: #fff; border-color: #9d4c00; }
  .visual-adoption__point small { display: block; margin-bottom: 0.15rem; color: #a65b1b; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; }
  .visual-adoption__point--end small { color: #ffe0bf; }
  .visual-adoption__point strong { display: block; font-family: var(--f-heading); font-size: 0.78rem; line-height: 1.2; }
  .visual-adoption__line { height: 1px; background: #bd6e25; position: relative; }
  .visual-adoption__line::after { content: ''; position: absolute; top: -3px; right: -1px; width: 7px; height: 7px; border-top: 1px solid #bd6e25; border-right: 1px solid #bd6e25; transform: rotate(45deg); }
  .visual-cli {
    width: min(100%, 340px);
    padding: 1.1rem;
    border-radius: 11px;
    background: #10261b;
    box-shadow: 0 14px 30px rgba(16,38,27,0.18);
    color: #d5f5e4;
    font: 600 0.75rem monospace;
  }
  .visual-cli span { display: block; padding: 0.3rem 0; }
  .visual-cli__prompt { color: #84e5ad; }
  .visual-cli__line { color: #aac7b6; }
  .visual-cli__done { color: #fff; }
  @media (max-width: 760px) {
    .projects__grid { grid-template-columns: 1fr; }
  }

  /* ─ EXPERIENCE ─ */
  .experience {
    position: relative;
    z-index: 2;
    margin-top: -1.5rem;
    padding-block: clamp(4rem, 7vw, 6rem);
    border-radius: 36px 36px 0 0;
    background: #111a2d;
    color: #fff;
  }
  .experience .section-header { border-color: rgba(255,255,255,0.18); }
  .experience .section-header__link, .experience .exp__period, .experience .exp__desc { color: rgba(255,255,255,0.64); }
  .experience .section-header__link:hover { color: #fff; }
  .exp__list { display: flex; flex-direction: column; margin-top: 2rem; }
  .exp__item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
