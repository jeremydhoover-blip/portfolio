---
import '../styles/global.css';
import '../styles/colorblock.css';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Jeremy Hoover designs customer-facing developer tools, content experiences, product systems, and AI-powered workflows." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg?v=5`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Jeremy Hoover" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://jeremyhoover.ai/" />

    <title>{title}</title>
    <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@600;700&family=Fraunces:ital,wght@0,700;0,800;0,900;1,700;1,800;1,900&family=Archivo+Narrow:wght@700&family=JetBrains+Mono:wght@700&display=swap" rel="stylesheet" />
    <!-- Fraunces' black italic J has a kink where the stem meets the tail; this one-letter font swaps in a smoothed J. Declared after the Google Fonts link so it wins for U+004A only. -->
    <style is:inline>@font-face { font-family: 'Fraunces'; font-style: italic; font-weight: 900; font-display: swap; src: url('/fonts/fraunces-j-black-italic.woff2') format('woff2'); unicode-range: U+004A; }</style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <nav class="nav" aria-label="Primary navigation">
      <div class="container nav__inner">
        <a href={`${base}/`} class="nav__logo" aria-label="Jeremy Hoover, home">
          <span class="nav__wordmark">Jeremy Hoover<span class="nav__dot" aria-hidden="true">.</span></span>
        </a>
        <button class="nav__toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links"><span aria-hidden="true"></span></button>
        <ul class="nav__links" id="nav-links">
          <li><a href={`${base}/#projects`}>Projects</a></li>
          <li><a href={`${base}/#experience`}>Experience</a></li>
          <li><a href={`${base}/#program`}>Program</a></li>
          <li class="nav__item--desktop"><a href={`${base}/#open-source`}>Open source</a></li>
          <li><a href={`${base}/about`}>About</a></li>
        </ul>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container footer__inner">
        <span>© 2026 Jeremy Hoover</span>
        <ul class="footer__links">
          <li><a href="https://www.linkedin.com/in/jeremydhoover/" target="_blank" rel="noopener"><Icon name="linkedin" size={16} />LinkedIn</a></li>
          <li><a href="https://github.com/jeremydhoover-blip" target="_blank" rel="noopener"><Icon name="github" size={16} />GitHub</a></li>
          <li><a href="mailto:jeremyd.hoover@gmail.com"><Icon name="mail" size={16} />Email</a></li>
        </ul>
      </div>
    </footer>
    <script is:inline>
      // Phone menu: the yellow button opens and closes the link list.
      (() => {
        const nav = document.querySelector('.nav'), btn = nav && nav.querySelector('.nav__toggle');
        if (!btn) return;
        const set = (open) => { nav.classList.toggle('nav--open', open); btn.setAttribute('aria-expanded', String(open)); btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); };
        btn.addEventListener('click', () => set(!nav.classList.contains('nav--open')));
        nav.querySelectorAll('.nav__links a').forEach((a) => a.addEventListener('click', () => set(false)));
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && nav.classList.contains('nav--open')) { set(false); btn.focus(); } });
      })();
    </script>
    <script is:inline>
      // Color-block: long sections collapse behind "Keep reading" on phones; open them on wider screens.
      if (matchMedia('(min-width: 901px)').matches) document.querySelectorAll('details.cb-keep').forEach((d) => { d.open = true; });
      // Color-block: "Give this to your AI agent" copy button.
      document.querySelectorAll('[data-copy]').forEach((btn) => btn.addEventListener('click', async () => {
        const label = btn.querySelector('span');
        try { await navigator.clipboard.writeText(btn.dataset.copy); } catch { return; }
        btn.classList.add('is-copied'); if (label) label.textContent = 'Copied';
        setTimeout(() => { btn.classList.remove('is-copied'); if (label) label.textContent = 'Copy'; }, 1800);
      }));
    </script>
  </body>
</html>
