{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeremydhoover-blip.github.io/portfolio/portfolio-standards.schema.json",
  "title": "Jeremy Hoover portfolio quality standards",
  "type": "object",
  "required": ["version", "site", "brand", "content", "accessibility"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "site": {
      "type": "object",
      "required": ["basePath", "canonicalOrigin", "requiredRoutes", "forbiddenDomains"],
      "properties": {
        "basePath": { "type": "string", "pattern": "^/[^/]+$" },
        "canonicalOrigin": { "type": "string", "format": "uri" },
        "requiredRoutes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "forbiddenDomains": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "required": ["colors", "fonts"],
      "properties": {
        "colors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        },
        "fonts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "content": {
      "type": "object",
      "required": ["forbiddenCharacters", "requiredPositioningTerms"],
      "properties": {
        "forbiddenCharacters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "requiredPositioningTerms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "required": ["documentLanguage", "h1PerPage", "requireMetaDescription", "requireImageAlt", "requireNoopenerForBlankTargets", "disallowHeadingSkips", "requireSkipLinkTarget"],
      "properties": {
        "documentLanguage": { "type": "string", "minLength": 2 },
        "h1PerPage": { "type": "integer", "minimum": 1 },
        "requireMetaDescription": { "type": "boolean" },
        "requireImageAlt": { "type": "boolean" },
        "requireNoopenerForBlankTargets": { "type": "boolean" },
        "disallowHeadingSkips": { "type": "boolean" },
        "requireSkipLinkTarget": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
